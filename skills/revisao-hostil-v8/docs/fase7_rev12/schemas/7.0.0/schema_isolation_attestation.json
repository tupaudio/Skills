{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revisao-hostil.v8/schemas/7.0.0/schema_isolation_attestation.json",
  "title": "Atestacao de Isolamento de Contexto (Fase 7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "campaign_id",
    "input_bundle_sha256",
    "peer_opinions_excluded",
    "attested_at_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(?![\\r\\n])$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    },
    "peer_opinions_excluded": {
      "type": "boolean",
      "const": true
    },
    "attested_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
