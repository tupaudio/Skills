{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revisao-hostil.v8/schemas/7.0.0/schema_campaign_manifest.json",
  "title": "Manifesto de Campanha (Fase 7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "policy_seq",
    "policy_jcs_sha256",
    "compatibility_policy_jcs_sha256",
    "anchor_classification",
    "manifest_jcs_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(?![\\r\\n])$"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,31})(?![\\r\\n])$"
    },
    "policy_jcs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    },
    "compatibility_policy_jcs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    },
    "anchor_classification": {
      "type": "string",
      "enum": [
        "ancoragem_externa_independente",
        "integridade_local_com_ancora_co_localizada"
      ]
    },
    "manifest_jcs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    }
  }
}
