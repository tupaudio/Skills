{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revisao-hostil.v8/schemas/7.0.0/schema_adversarial_contestation.json",
  "title": "Contestacao Adversarial (Fase 7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contestation_id",
    "contesting_agent_id",
    "target_parecer_sha256",
    "contested_finding",
    "qualified_evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(?![\\r\\n])$"
    },
    "contestation_id": {
      "type": "string",
      "minLength": 1
    },
    "contesting_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "target_parecer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    },
    "contested_finding": {
      "$ref": "./schema_achado.json"
    },
    "qualified_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./schema_evidence_qualification.json"
      }
    }
  }
}
