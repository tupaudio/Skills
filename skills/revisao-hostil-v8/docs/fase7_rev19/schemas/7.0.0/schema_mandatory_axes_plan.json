{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revisao-hostil.v8/schemas/7.0.0/schema_mandatory_axes_plan.json",
  "title": "Plano Imutavel de Eixos Obrigatorios (Fase 7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "perfil_sha256",
    "eixos_obrigatorios",
    "plan_jcs_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(?![\\r\\n])$"
    },
    "perfil_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    },
    "eixos_obrigatorios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eixo_id",
          "peso_decimal"
        ],
        "properties": {
          "eixo_id": {
            "type": "string",
            "minLength": 1
          },
          "peso_decimal": {
            "type": "string",
            "pattern": "^(1000(\\.0{1,6})?|[1-9][0-9]{0,2}(\\.[0-9]{1,6})?|0\\.[0-9]{0,5}[1-9][0-9]{0,5})(?![\\r\\n])$",
            "description": "Peso decimal estrito no dominio (0, 1000] com ate 6 casas decimais."
          }
        }
      }
    },
    "plan_jcs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\r\\n])$"
    }
  }
}
